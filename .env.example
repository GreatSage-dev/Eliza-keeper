# KeeperHub MCP endpoint
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# KeeperHub API key
KEEPERHUB_API_KEY=your_api_key_here

# Auto-execution threshold in USD.
# Transactions at or below this value execute autonomously after dry-run passes.
# Transactions above this value pause for human approval.
# Set to 0 or omit to always require approval.
KEEPER_AUTO_THRESHOLD_USD=50
